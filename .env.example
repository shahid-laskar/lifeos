# Required outside local development. Never commit real secrets.
MLOS_JWT_SECRET_KEY=replace-with-a-long-random-secret
MLOS_ENVIRONMENT=development
MLOS_DATABASE_URL=sqlite:///./muslim_life_os.db

# --- AI (OpenRouter / OpenAI-compatible) ---
# Leave MLOS_AI_PROVIDER empty to use the local stub (no network calls).
# For OpenRouter:
#   MLOS_AI_PROVIDER=openrouter
#   MLOS_OPENAI_API_KEY=sk-or-v1-...
#   MLOS_AI_MODEL=openai/gpt-4o-mini   # optional; this is the default for openrouter
# For OpenAI directly:
#   MLOS_AI_PROVIDER=openai
#   MLOS_OPENAI_API_KEY=sk-...
#   MLOS_AI_MODEL=gpt-4o-mini
# MLOS_AI_PROVIDER=
# MLOS_OPENAI_API_KEY=
# MLOS_OPENAI_BASE_URL=
# MLOS_AI_MODEL=
